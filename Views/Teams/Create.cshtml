@model Team
@{ ViewData["Title"] = "Thêm đội bóng"; }
<div class="page-header"><h1>Thêm đội bóng</h1></div>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
