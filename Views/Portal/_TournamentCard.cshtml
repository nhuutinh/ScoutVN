@model TournamentCard
@{ var t = Model.Tournament; }
<a class="pv-card pv-tour d-block" asp-controller="Portal" asp-action="Tournament" asp-route-id="@t.Id">
    <div class="d-flex justify-content-between align-items-start">
        <div class="season">Mùa @t.Season</div>
        <span class="badge bg-light text-dark border">@t.Type.DisplayName()</span>
    </div>
    <h3>@t.Name</h3>
    <div class="nums mb-2">
        <div><b>@Model.Players</b>cầu thủ</div>
        <div><b>@Model.Goals</b>bàn thắng</div>
    </div>
    @if (Model.TopScorer != null)
    {
        <div class="small text-muted border-top pt-2"><i class="bi bi-bullseye text-success"></i> Dẫn đầu: <b class="text-dark">@Model.TopScorer</b> (@Model.TopScorerGoals bàn)</div>
    }
    else
    {
        <div class="small text-muted border-top pt-2">Chưa có số liệu thống kê.</div>
    }
</a>
