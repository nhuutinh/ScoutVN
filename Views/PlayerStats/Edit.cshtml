@model PlayerStat
@{ ViewData["Title"] = "Sửa thống kê thi đấu"; }
<div class="page-header"><h1>Sửa thống kê thi đấu</h1></div>
<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu</button>
            <a asp-controller="Players" asp-action="Details" asp-route-id="@Model.PlayerId" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
