@model IPagedList
@{
    // Giữ nguyên các tham số lọc hiện tại, chỉ thay đổi số trang
    string PageUrl(int p)
    {
        var q = Context.Request.Query
            .Where(kv => !kv.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"page={p}");
        return $"{Context.Request.Path}?{string.Join("&", q)}";
    }
    int from = Math.Max(1, Model.PageIndex - 2);
    int to = Math.Min(Model.TotalPages, Model.PageIndex + 2);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="text-muted small">
        @if (Model.TotalCount == 0) { <text>Không có dữ liệu</text> }
        else { <text>Hiển thị @((Model.PageIndex - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)) / @Model.TotalCount bản ghi</text> }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")"><a class="page-link" href="@PageUrl(Model.PageIndex - 1)">&laquo;</a></li>
                @if (from > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                    if (from > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (int i = from; i <= to; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")"><a class="page-link" href="@PageUrl(i)">@i</a></li>
                }
                @if (to < Model.TotalPages)
                {
                    if (to < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")"><a class="page-link" href="@PageUrl(Model.PageIndex + 1)">&raquo;</a></li>
            </ul>
        </nav>
    }
</div>
